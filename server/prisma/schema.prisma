// Gera o Prisma Client utilizado pelo backend para acessar o banco.
// O client será gerado dentro de src/generated/prisma.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Define o banco utilizado pela aplicação.
// A URL de conexão fica no prisma.config.ts / DATABASE_URL.
datasource db {
  provider = "postgresql"
}

// Papéis disponíveis para um usuário da aplicação.
enum UserRole {
  CUSTOMER
  ADMIN
}

// Representa um usuário cadastrado na Le Coast.
model User {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  name String

  // @unique impede dois usuários de utilizarem o mesmo e-mail.
  email String @unique

  // No TypeScript será passwordHash, mas no PostgreSQL será password_hash.
  // Armazena somente o hash da senha, nunca a senha original.
  passwordHash String @map("password_hash")

  // Todo novo usuário começa como cliente por padrão.
  role UserRole @default(CUSTOMER)

  // Permite desativar uma conta sem precisar excluí-la.
  isActive Boolean @default(true) @map("is_active")

  // now() define automaticamente a data de criação.
  createdAt DateTime @default(now()) @map("created_at")

  // @updatedAt atualiza essa data automaticamente a cada alteração.
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relação 1:N:
  // um usuário pode possuir vários endereços.
  // Este campo representa a relação no Prisma e não cria
  // uma coluna "addresses" na tabela users.
  addresses Address[]

  // Relação 1:N:
  // um usuário pode possuir várias sessões ativas,
  // cada uma representada por um refresh token.
  refreshTokens RefreshToken[]

  // Um usuário pode possuir diferentes solicitações de
  // recuperação ao longo do tempo, mantendo seu histórico.
  passwordResetTokens PasswordResetToken[]

  // Relação 1:N:
  // um usuário pode possuir vários pedidos.
  orders Order[]

  // Mantém o model como User no Prisma/TypeScript,
  // mas utiliza "users" como nome da tabela no PostgreSQL.
  @@map("users")
}

// Representa um endereço salvo por um usuário.
model Address {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Chave estrangeira que referencia User.id.
  // No Prisma será userId e no PostgreSQL será user_id.
  userId Int @map("user_id")

  // Nome dado ao endereço, por exemplo "Casa" ou "Trabalho".
  name String

  street String
  number String

  // O ? significa que o campo é opcional e pode ser NULL.
  complement String?

  neighborhood String
  city         String
  state        String

  // No Prisma será zipCode e no PostgreSQL será zip_code.
  zipCode String @map("zip_code")

  // Como o e-commerce é brasileiro, BR será usado por padrão.
  country String @default("BR")

  // Indica se este é o endereço principal do usuário.
  isDefault Boolean @default(false) @map("is_default")

  // Datas continuam em camelCase no Prisma e snake_case no banco.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Define a relação entre Address e User.
  //
  // fields: campo deste model que contém a FK.
  // references: campo correspondente no model User.
  //
  // onDelete: Cascade significa que, se o usuário for realmente
  // excluído do banco, seus endereços também serão excluídos.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cria um índice para melhorar buscas de endereços por usuário.
  @@index([userId])
  // Mantém o model como Address no Prisma/TypeScript,
  // mas utiliza "addresses" como nome da tabela no PostgreSQL.
  @@map("addresses")
}

// Representa uma sessão renovável de autenticação.
// Guardamos somente o hash do refresh token no banco,
// nunca o token original entregue ao cliente.
model RefreshToken {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Usuário ao qual esta sessão pertence.
  userId Int @map("user_id")

  // Hash do refresh token.
  // @unique impede dois registros de possuírem o mesmo token.
  tokenHash String @unique @map("token_hash")

  // Data limite em que este refresh token pode ser utilizado.
  expiresAt DateTime @map("expires_at")

  // Quando preenchido, significa que o token foi revogado
  // e não pode mais ser usado para renovar a sessão.
  revokedAt DateTime? @map("revoked_at")

  // Registra quando esta sessão foi criada.
  createdAt DateTime @default(now()) @map("created_at")

  // Define a relação com o usuário dono desta sessão.
  //
  // onDelete: Cascade remove os refresh tokens caso
  // o usuário seja realmente excluído do banco.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Melhora consultas das sessões pertencentes a um usuário.
  @@index([userId])
  // Mantém RefreshToken no Prisma/TypeScript,
  // mas utiliza refresh_tokens no PostgreSQL.
  @@map("refresh_tokens")
}

// Representa um token temporário utilizado para redefinir
// a senha de um usuário que perdeu acesso à conta.
model PasswordResetToken {
  // Identificador único do token de recuperação.
  id Int @id @default(autoincrement())

  // Usuário ao qual a solicitação de recuperação pertence.
  userId Int @map("user_id")

  // Armazena somente o hash do token enviado ao usuário.
  // Assim, um vazamento do banco não expõe diretamente
  // tokens válidos de redefinição de senha.
  tokenHash String @unique @map("token_hash")

  // Define até quando o token pode ser utilizado.
  // Tokens de recuperação devem possuir vida curta
  // por permitirem a alteração de uma credencial sensível.
  expiresAt DateTime @map("expires_at")

  // Registra quando o token foi utilizado.
  // Depois de preenchido, o mesmo token não poderá
  // ser usado novamente para redefinir a senha.
  usedAt DateTime? @map("used_at")

  // Mantém o momento em que a solicitação foi criada.
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciona o token ao usuário que solicitou
  // a recuperação da senha.
  //
  // Cascade garante que tokens temporários também sejam
  // removidos caso o usuário seja excluído definitivamente.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Facilita consultas dos tokens pertencentes
  // a determinado usuário.
  @@index([userId])
  // Mantém PascalCase no Prisma/TypeScript e
  // snake_case diretamente no PostgreSQL.
  @@map("password_reset_tokens")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Representa um pedido realizado por um usuário.
model Order {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Usuário responsável pelo pedido.
  userId Int @map("user_id")

  // Status atual do fluxo logístico do pedido.
  status OrderStatus @default(PENDING)

  // Status atual do pagamento.
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  // Gateway utilizado para processar o pagamento.
  // Pode permanecer vazio enquanto o pagamento
  // ainda não tiver sido iniciado.
  paymentGateway String? @map("payment_gateway")

  // Identificador externo retornado pelo gateway.
  paymentId String? @map("payment_id")

  // Valor total congelado no momento da criação do pedido.
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  // Datas de criação e atualização do pedido.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Define o usuário proprietário do pedido.
  user User @relation(fields: [userId], references: [id])

  // Cada pedido possui uma cópia do endereço utilizado
  // no momento da compra.
  address OrderAddress?

  // Um pedido possui um ou mais itens.
  items OrderItem[]

  // Facilita consultas dos pedidos pertencentes a um usuário.
  @@index([userId])
  @@map("orders")
}

// Mantém uma cópia do endereço utilizado no pedido.
//
// O endereço do usuário pode ser editado ou excluído depois,
// mas os dados históricos do pedido devem permanecer imutáveis.
model OrderAddress {
  id Int @id @default(autoincrement())

  // Relação 1:1 com o pedido.
  orderId Int @unique @map("order_id")

  name         String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String  @map("zip_code")
  country      String  @default("BR")

  createdAt DateTime @default(now()) @map("created_at")

  // Se o pedido for removido, seu snapshot de endereço
  // também deixa de ter utilidade.
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

// Representa um item congelado no momento da compra.
//
// Guardamos quantidade e preço no pedido para preservar
// o histórico mesmo que o produto mude posteriormente.
model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int @map("order_id")

  // Identificador da variação comprada.
  variantId Int @map("variant_id")

  quantity Int

  // Preço unitário congelado no momento da compra.
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Relaciona o item do pedido à variação comprada.
  //
  // O OrderItem mantém seus próprios dados históricos,
  // mas a FK garante que a variação referenciada exista.
  variant ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshot do nome do produto no momento da compra.
  //
  // Mesmo que o produto seja renomeado posteriormente,
  // o pedido continuará exibindo o nome original.
  productName String @map("product_name")

  // Snapshot do tamanho comprado.
  //
  // Isso preserva o histórico mesmo que o nome do tamanho
  // seja alterado posteriormente no catálogo.
  sizeName String @map("size_name")

  // Snapshot da cor comprada.
  //
  // Assim, alterações futuras na cor cadastrada não modificam
  // a descrição de itens pertencentes a pedidos antigos.
  colorName String @map("color_name")

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// Representa uma categoria utilizada para organizar
// os produtos da Le Coast.
//
// A relação com ela mesma permite criar uma hierarquia,
// como "Fitness" → "Leggings" ou "Praia" → "Biquínis".
model Category {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Nome exibido para o cliente.
  // Deve ser único para evitar categorias duplicadas.
  name String @unique

  // Identificador amigável utilizado nas URLs.
  // Exemplo: "Moda Praia" → "moda-praia".
  slug String @unique

  // Categoria pai, quando esta categoria for uma subcategoria.
  // NULL indica que esta é uma categoria principal.
  parentId Int? @map("parent_id")

  // Permite ocultar uma categoria sem apagar seu histórico.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relação recursiva:
  // uma categoria pode possuir uma categoria pai.
  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])

  // Relação inversa:
  // uma categoria pode possuir várias subcategorias.
  children Category[] @relation("CategoryHierarchy")

  // Uma categoria pode possuir vários produtos.
  products Product[]

  // Facilita consultas pelas subcategorias de uma categoria.
  @@index([parentId])
  @@map("categories")
}

// Representa um tamanho disponível para as variações
// dos produtos da Le Coast.
model Size {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Nome do tamanho exibido ao cliente.
  // Exemplos: PP, P, M, G, GG ou Único.
  name String @unique

  // Permite desativar um tamanho sem removê-lo do banco,
  // preservando referências e dados históricos.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Um produto pode possuir várias combinações
  // vendáveis de tamanho e cor.
  variants ProductVariant[]

  @@map("sizes")
}

// Representa uma cor disponível para as variações
// dos produtos da Le Coast.
model Color {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Nome da cor exibido ao cliente.
  // Exemplos: Preto, Branco ou Azul-marinho.
  name String @unique

  // Representação hexadecimal opcional da cor.
  // Algumas estampas ou combinações podem não ser
  // representadas adequadamente por uma única cor.
  hexCode String? @map("hex_code")

  // Permite desativar uma cor sem apagar registros
  // que possam estar relacionados a produtos históricos.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Um produto pode possuir várias combinações
  // vendáveis de tamanho e cor.
  variants ProductVariant[]

  @@map("colors")
}

// Representa um produto da Le Coast.
//
// O produto contém as informações gerais da peça.
// Preço, estoque, tamanho e cor pertencem às suas variações,
// pois podem ser diferentes para cada combinação vendável.
model Product {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Categoria principal à qual o produto pertence.
  categoryId Int @map("category_id")

  // Nome exibido ao cliente.
  name String

  // Identificador amigável utilizado na URL do produto.
  // Deve ser único para que cada produto possua sua própria rota.
  slug String @unique

  // Descrição detalhada da peça.
  // É opcional para permitir o cadastro inicial mesmo
  // quando a descrição ainda não estiver pronta.
  description String?

  // Permite retirar um produto da loja sem apagá-lo
  // e comprometer informações relacionadas.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cada produto pertence a uma única categoria principal.
  category Category @relation(fields: [categoryId], references: [id])

  // Um produto pode possuir várias combinações
  // vendáveis de tamanho e cor.
  variants ProductVariant[]

  // Facilita consultas dos produtos pertencentes
  // a uma determinada categoria.
  @@index([categoryId])
  @@map("products")
}

// Representa uma combinação vendável de um produto.
//
// Exemplo:
// Top Essential + tamanho M + cor Preto.
//
// Preço e estoque ficam na variação porque diferentes
// combinações podem possuir valores e estoques diferentes.
model ProductVariant {
  // Chave primária gerada automaticamente pelo PostgreSQL.
  id Int @id @default(autoincrement())

  // Produto ao qual esta variação pertence.
  productId Int @map("product_id")

  // Tamanho utilizado nesta variação.
  sizeId Int @map("size_id")

  // Cor utilizada nesta variação.
  colorId Int @map("color_id")

  // Código único utilizado para identificar a variação.
  // Exemplo: TOP-ESS-M-PRETO.
  sku String @unique

  // Preço atual de venda desta variação.
  price Decimal @db.Decimal(10, 2)

  // Quantidade atualmente disponível em estoque.
  stock Int @default(0)

  // Permite desativar uma variação sem excluí-la,
  // preservando referências e histórico.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cada variação pertence a um produto.
  product Product @relation(fields: [productId], references: [id])

  // Cada variação possui um tamanho.
  size Size @relation(fields: [sizeId], references: [id])

  // Cada variação possui uma cor.
  color Color @relation(fields: [colorId], references: [id])

  // Pedidos que já utilizaram esta variação.
  //
  // Essa relação também reforça que variantes usadas em pedidos
  // não devem ser simplesmente apagadas do banco.
  orderItems OrderItem[]

  // Impede que a mesma combinação de produto,
  // tamanho e cor seja cadastrada mais de uma vez.
  @@unique([productId, sizeId, colorId])
  // Facilita consultas das variações de determinado produto.
  @@index([productId])
  @@map("product_variants")
}
